# ---------------------------------------------------------------------------
# Estada server environment variables
# Copy this file to `.env` and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# App
NODE_ENV=development
PORT=5000
# Comma-separated list of allowed frontend origins (CORS)
CLIENT_URL=http://localhost:5173

# Database (MySQL 8 — local, free, no credit card)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Example for a local MySQL install with the root user:
DATABASE_URL="mysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/estada"

# Auth
# Generate a long random string, e.g. in PowerShell:
#   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SECRET="change_me_to_a_long_random_secret"
JWT_EXPIRES_IN=7d

# Google OAuth (free, no card) — added in a later milestone
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary (free tier, no card) — property images & documents
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (Nodemailer) — saved-search alerts & enquiry notifications
# For local dev you can use a free Ethereal (ethereal.email) test inbox.
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Estada <no-reply@estada.app>"

# Web Push (VAPID) — push notifications. Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@estada.app
