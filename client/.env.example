# ---------------------------------------------------------------------------
# Estada client environment variables (Vite exposes only VITE_* to the browser)
# Copy to `.env` for local dev. NEVER put server secrets here — anything here
# ships in the browser bundle.
# ---------------------------------------------------------------------------

# Base URL for API calls. In dev, Vite proxies /api to the server (see vite.config.ts),
# so you can leave this as /api.
VITE_API_URL=/api

# Google OAuth public client id (safe to expose) — added in a later milestone.
VITE_GOOGLE_CLIENT_ID=

# NOTE: We use Leaflet + OpenStreetMap for maps (free, no API key, no credit card),
# so there is deliberately NO Google Maps key here.
